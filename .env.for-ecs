# DeepSeek API Configuration
OPENAI_API_KEY=sk-your-deepseek-api-key-here
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat

# 图像生成配置
IMAGE_API_KEY=sk-your-dashscope-api-key-here
IMAGE_API_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation
IMAGE_MODEL=qwen-image-max
TEXT_TO_IMAGE_MODELS=qwen-image-max,qwen-image-plus,qwen-image
IMAGE_EDIT_MODELS=qwen-image-edit-max,qwen-image-edit-plus

# 图片存储配置
IMAGE_STORAGE_TYPE=local
IMAGE_LOCAL_PATH=./data/images
IMAGE_GENERATION_TIMEOUT=60
IMAGE_MAX_RETRIES=3

# 向量检索配置
ENABLE_VECTOR_SEARCH=true
VECTOR_STORE_PATH=./data/vector_store

# 网易云音乐 API 配置（内部网络）
NETEASE_MUSIC_API_URL=http://music-api:3001

# 应用配置
ENVIRONMENT=production
DEFAULT_LANGUAGE=zh
CACHE_EVENTS=true
CORS_ORIGINS=http://47.250.162.194,https://yourdomain.com

# 叙事引擎三大系统
ENABLE_CONSTRAINT_HARNESS=true
ENABLE_NARRATIVE_STYLE_ENGINE=true
ENABLE_CREATIVE_ENHANCEMENT=true
ENABLE_EPIC_NARRATIVE=true

# 数据库配置（使用 SQLite）
# DATABASE_URL=postgresql://user:pass@host:5432/db
