# ========== DeepSeek AI 配置 ==========
OPENAI_API_KEY=your-deepseek-api-key-here
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-v4-flash
# 人生总结是前台同步操作；超时后服务端返回基于已保存故事的确定性总结。
LIFE_SUMMARY_TIMEOUT_SECONDS=25

# ========== 游戏配置 ==========
DEFAULT_LANGUAGE=zh
CACHE_EVENTS=true

# ========== CORS 配置 ==========
# 本地开发：CORS_ORIGINS=http://localhost:3000
# 生产环境：CORS_ORIGINS=https://yourdomain.com
# 多个来源用逗号分隔
CORS_ORIGINS=http://localhost:3000

# ========== 图像生成服务（MiniMax image_generation） ==========
# 如留空，后端会复用 MINIMAX_API_KEY。
IMAGE_API_KEY=
IMAGE_API_BASE_URL=https://api.minimaxi.com/v1
IMAGE_MODEL=image-01

# 模型降级列表（高优先级在前，逗号分隔）
# 当高优模型因429速率限制失败时，自动降级至备用模型
TEXT_TO_IMAGE_MODELS=image-01,image-01-live
IMAGE_EDIT_MODELS=image-01,image-01-live

# 图片存储配置
IMAGE_STORAGE_TYPE=local
IMAGE_LOCAL_PATH=./data/images

# 图像生成超时与重试
# 图生图需要上传base64参考图+等待生成+下载结果，建议180秒
IMAGE_GENERATION_TIMEOUT=180
IMAGE_MAX_RETRIES=3

# OSS 配置（可选，长期使用时填写）
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# OSS_ENDPOINT=
# OSS_BUCKET_NAME=

# ========== 网易云音乐 API ==========
# 本地开发：http://localhost:3001
# Docker/ECS：http://music-api:3001
NETEASE_MUSIC_API_URL=http://localhost:3001

# ========== MiniMax 故事朗读与音乐生成 ==========
# 生产环境要启用 MiniMax 后端朗读：
# STORY_TTS_PROVIDER=minimax
# STORY_TTS_ALLOW_REQUEST_PROVIDER=1
MINIMAX_API_KEY=
MINIMAX_TTS_MODEL=speech-02-turbo
MINIMAX_MUSIC_MODEL=music-2.6
MINIMAX_TIMEOUT_SECONDS=180
MINIMAX_TTS_MAX_CHARS=50000
MINIMAX_MUSIC_PROMPT_MAX_CHARS=900
STORY_TTS_PROVIDER=browser
STORY_TTS_ALLOW_REQUEST_PROVIDER=0
STORY_TTS_AUTO_READ_DEFAULT_ENABLED=false
STORY_TTS_ASSET_DIR=./data/voice_assets
STORY_MUSIC_AI_GENERATION_ENABLED=true
STORY_MUSIC_ASSET_DIR=./data/music_assets
# 仅用于本地/E2E 离线音频夹具，生产环境不要开启
MINIMAX_E2E_LOCAL_AUDIO=false

# ========== 叙事引擎三大系统 ==========
ENABLE_CONSTRAINT_HARNESS=true
ENABLE_SOFT_NARRATIVE_LENGTHS=false
ENABLE_NARRATIVE_STYLE_ENGINE=true
ENABLE_CREATIVE_ENHANCEMENT=true
ENABLE_EPIC_NARRATIVE=true

# ========== 认证 ==========
JWT_SECRET=your-jwt-secret-here

# ========== 生产环境配置 ==========
# ENVIRONMENT=production
# LOG_LEVEL=INFO

# ========== Sentry 监控（可选）==========
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
# SENTRY_TRACES_SAMPLE_RATE=0.1
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=development

# ========== 数据库（默认 SQLite，可选 PostgreSQL）==========
# DATABASE_URL=postgresql://user:pass@host:5432/db
