# OpenAI API配置
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4
OPENAI_BASE_URL=

# 图像生成配置
# TEXT_TO_IMAGE_MODELS=qwen-image-max,wanx2.1-v2,qwen-image-plus
# IMAGE_EDIT_MODELS=qwen-image-edit-max,qwen-image-edit-plus

# 数据库配置（可选）
# 如果使用PostgreSQL，取消注释并填写：
# DATABASE_URL=postgresql://username:password@host:5432/database_name
# 如果使用SQLite（默认），留空即可

# 应用配置
DEFAULT_LANGUAGE=zh
CACHE_EVENTS=true

# 生产环境配置（可选）
# ENVIRONMENT=production
# LOG_LEVEL=INFO

# Sentry 错误监控（可选，留空则不启用）
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# 前端 Sentry（可选，留空则不启用）
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development

# ========== 叙事引擎三大系统 ==========
ENABLE_CONSTRAINT_HARNESS=false
ENABLE_CREATIVE_ENHANCEMENT=false
ENABLE_NARRATIVE_STYLE_ENGINE=false
ENABLE_EPIC_NARRATIVE=false
